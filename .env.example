N8N_TO_CONVEX_SECRET=
APP_TIMEZONE=UTC
LENDLOOP_CONVEX_HTTP_URL=http://host.docker.internal:3211
N8N_NOTIFY_URL=http://localhost:5678/webhook/lendloop-notify
