# Docker n8n (.env): generate independent random secrets, e.g. openssl rand -hex 32
N8N_ENCRYPTION_KEY=
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=
APP_TIMEZONE=UTC
LENDLOOP_CONVEX_HTTP_URL=http://host.docker.internal:3211
# Next.js/Convex CLI (.env.local); only NEXT_PUBLIC values go to the browser
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
# Also set issuer + both directional secrets in the Convex deployment environment.
N8N_NOTIFY_URL=http://localhost:5678/webhook/lendloop-notify
