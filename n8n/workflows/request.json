{
  "id": "LendLoopNotifyM1",
  "name": "Foundation probe: signed round trip",
  "nodes": [
    {
      "id": "Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "lendloop-notify",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "lendloop-notify-m1"
    },
    {
      "id": "Verify",
      "name": "Verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 0],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst input = $input.first().json;\nconst headers = input.headers || {};\nconst body = input.body;\nconst timestamp = headers['x-lendloop-timestamp'];\nconst signature = headers['x-lendloop-signature'];\nfunction reject(status) { return [{json:{valid:false,status}}]; }\nif (Number(headers['content-length'] || 0) > 65536 || Buffer.byteLength(JSON.stringify(body || {}),'utf8') > 65536) return reject(413);\nif (!body || Object.keys(body).length !== 1 || typeof body.payload !== 'string') return reject(400);\nif (!/^\\d+$/.test(timestamp || '') || Math.abs(Date.now()/1000 - Number(timestamp)) > 300 || !/^v1=[a-f0-9]{64}$/.test(signature || '')) return reject(401);\nconst expected = crypto.createHmac('sha256',$env.CONVEX_TO_N8N_SECRET).update(`v1\\n${timestamp}\\nnotify\\n${body.payload}`,'utf8').digest();\nif (!crypto.timingSafeEqual(expected, Buffer.from(signature.slice(3),'hex'))) return reject(401);\nlet payload; try { payload = JSON.parse(body.payload); } catch { return reject(400); }\nif (payload.spike !== true || typeof payload.message !== 'string' || payload.message.length > 500) return reject(400);\nreturn [{json:{valid:true,payload}}];"
      }
    },
    {
      "id": "Valid",
      "name": "Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [400, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "Sign-callback",
      "name": "Sign callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 0],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst value=$input.first().json.payload;\nif(value.forceFailure) throw new Error('M1 intentional error-workflow probe');\nconst payload=JSON.stringify({spike:true,message:value.message});\nconst timestamp=String(Math.floor(Date.now()/1000));\nconst signature='v1='+crypto.createHmac('sha256',$env.N8N_TO_CONVEX_SECRET).update(`v1\\n${timestamp}\\nnotification-result\\n${payload}`,'utf8').digest('hex');\nreturn [{json:{timestamp,signature,envelope:JSON.stringify({payload})}}];"
      }
    },
    {
      "id": "Callback",
      "name": "Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_HTTP_URL + '/automation/notifications' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.envelope }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "Success",
      "name": "Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1100, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "Reject",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [600, 220],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"accepted\":false}",
        "options": {
          "responseCode": "={{ $json.status }}"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Verify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify": {
      "main": [
        [
          {
            "node": "Valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid": {
      "main": [
        [
          {
            "node": "Sign callback",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign callback": {
      "main": [
        [
          {
            "node": "Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Callback": {
      "main": [
        [
          {
            "node": "Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LendLoopErrorM1"
  },
  "active": true
}
