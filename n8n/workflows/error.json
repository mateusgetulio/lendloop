{
  "id": "LendLoopError",
  "name": "Workflow errors",
  "active": false,
  "nodes": [
    {
      "id": "Error-trigger",
      "name": "Error trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "Format-execution-failure",
      "name": "Format execution failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 0],
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nfunction signed(value,purpose){const payload=JSON.stringify(value),timestamp=String(Math.floor(Date.now()/1000));const signature='v1='+crypto.createHmac('sha256',$env.N8N_TO_CONVEX_SECRET).update('v1\\n'+timestamp+'\\n'+purpose+'\\n'+payload,'utf8').digest('hex');return {timestamp,signature,envelope:JSON.stringify({payload})};}\nconst value=$input.first().json;\nreturn [{json:signed({workflow:value.workflow?.id==='LendLoopNotify'?'request-notifications':'overdue-reminders',executionId:String(value.execution?.id||$execution.id),node:'execution-failed',message:'Workflow execution failed. Inspect the private execution record.'},'failure-report')}];"
      }
    },
    {
      "id": "Report-execution-failure",
      "name": "Report execution failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_HTTP_URL + '/automation/failures' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.envelope }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "Error trigger": {
      "main": [
        [
          {
            "node": "Format execution failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format execution failure": {
      "main": [
        [
          {
            "node": "Report execution failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
